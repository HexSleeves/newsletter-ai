# LLM Configuration
# Provider: anthropic, openai, gemini, openrouter
LLM_PROVIDER=anthropic
# Optional: Override default model (leave empty for provider default)
LLM_MODEL=

# API Keys (only the one for your chosen provider is required)
ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Database
DATABASE_URL=sqlite:///./newsletter.db

# RSS Feeds (comma-separated)
RSS_FEEDS=https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml
